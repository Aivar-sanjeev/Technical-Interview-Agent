# NVIDIA API key (https://build.nvidia.com — same key for NIM chat + Riva ASR metadata)
NVIDIA_API_KEY=

# OpenAI-compatible chat (plan, live interview, evaluation)
# NVIDIA_INFERENCE_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_PLAN_MODEL=openai/gpt-oss-20b
# NVIDIA_INTERVIEW_MODEL=openai/gpt-oss-20b
# NVIDIA_EVAL_MODEL=openai/gpt-oss-20b

# Nemotron ASR streaming (Riva gRPC) — speech-to-text
# NVIDIA_ASR_FUNCTION_ID=bb0837de-8c7b-481f-9ec8-ef5663e9c1fa
# NVIDIA_ASR_GRPC_URI=grpc.nvcf.nvidia.com:443
# NVIDIA_ASR_MODEL=

# Plan input size caps
# PLAN_MAX_JD_CHARS=6000
# PLAN_MAX_PROFILE_CHARS=4500

# Interview timing (see PLAN.md)
# QUESTION_TIMEOUT_SECONDS=120
# MAX_FOLLOW_UPS=2

# Voice lane: seconds of silence after interviewer → nudge LLM, then auto-advance (defaults are slower / more patient)
# VOICE_SILENCE_NUDGE_SECONDS=22
# VOICE_SILENCE_SKIP_SECONDS=28

# Nemotron STT needs ffmpeg in PATH to decode WebM from the browser (unless you send 16 kHz mono WAV).
